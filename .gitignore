# Build output
build/
DerivedData/
*.xcresult

# Swift Package Manager
.build/
.swiftpm/
Packages/*/.build/

# Locally downloaded tooling (XcodeGen and friends)
.tools/
.build-stamp

# The Xcode project is generated from project.yml but is committed on purpose,
# so the app can be opened without installing XcodeGen. Regenerate it with
# `xcodegen generate --spec project.yml` and commit the result; never hand-edit
# it. Scripts/verify-project.sh enforces this in CI.

# Local agent configuration
.devin/config.local.json

# Xcode user state
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout

# macOS
.DS_Store

# Local secrets — never commit these
.env
.env.local
*.pem
*.p12
*.mobileprovision
