# Build output
build/
DerivedData/
*.xcresult

# Swift Package Manager
.build/
.swiftpm/
Packages/*/.build/

# Locally downloaded tooling (XcodeGen and friends)
.tools/
.build-stamp

# Generated by XcodeGen from project.yml — regenerate, do not commit
*.xcodeproj/

# Local agent configuration
.devin/config.local.json

# Xcode user state
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout

# macOS
.DS_Store

# Local secrets — never commit these
.env
.env.local
*.pem
*.p12
*.mobileprovision
